# Browser (Vite) settings
VITE_RPC_URL=            # Solana RPC (Helius, Triton, QuickNode). Needed for coin launches.
VITE_CLUSTER=mainnet-beta  # pump.fun runs on mainnet-beta; use devnet only for testing

# Server settings (set these in the Vercel project, never in VITE_ vars)
ANTHROPIC_API_KEY=       # builds apps (api/generate.ts)
PINATA_JWT=              # publishes apps and coin metadata to IPFS
PINATA_GATEWAY=          # optional, e.g. you.mypinata.cloud
